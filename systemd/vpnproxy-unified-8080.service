[Unit]
Description=VPNManager unified proxy 8080 (mesmos protocolos da porta 80)
After=network-online.target ssh.service sshd-bhttp.service hcr-server.service vpnproxy-xhttp-11443.service
Wants=network-online.target ssh.service sshd-bhttp.service

[Service]
Type=simple
User=root
ExecStart=/etc/VPNManager/bin/vpnproxy-unified --port 8080 --silent-ws \
  --static-target 127.0.0.1:22 --idle 24h \
  --quic-port 8080 \
  --tls-cert /etc/VPNManager/conf/bhttp_80_cert.pem \
  --tls-key /etc/VPNManager/conf/bhttp_80_key.pem \
  --hcr-target 127.0.0.1:18082 \
  --xhttp-target 127.0.0.1:11443 \
  --ws-to 127.0.0.1:22
Restart=always
RestartSec=3
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
