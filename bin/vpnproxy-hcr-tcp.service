[Unit]
Description=VPNManager HCR TCP Proxy (TCP 8443 -> TCP 18082)
After=network.target hcr-server.service
Wants=hcr-server.service

[Service]
Type=simple
ExecStart=/etc/VPNManager/bin/hcr-tcp-proxy/hcr-tcp-proxy
Restart=always
RestartSec=2s
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
