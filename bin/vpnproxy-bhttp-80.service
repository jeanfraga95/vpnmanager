[Unit]
Description=VPNManager BHTTP publico 80 -> 2223, fallback 19080 (WS/XHTTP/HCR), sem nginx
After=network.target sshd-bhttp.service vpnproxy-fallback.service
Wants=sshd-bhttp.service vpnproxy-fallback.service

[Service]
User=root
ExecStart=/etc/VPNManager/bin/bhttpssh_dtp --port 80 --static-target 127.0.0.1:2223 --fallback-target 127.0.0.1:19080 --idle 24h --quic-port 80 --tls-cert /etc/VPNManager/conf/bhttp_80_cert.pem --tls-key /etc/VPNManager/conf/bhttp_80_key.pem
Restart=always
RestartSec=3
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
